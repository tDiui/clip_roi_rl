MOHINH/
│
├── checkpoints/                # Lưu trọng số tác tử Actor-Critic qua từng Epoch (vd: vmr_agent_epoch_40.pth) để phòng sự cố
│
├── config/                     # Cấu hình tham số hệ thống
│   ├── __init__.py
│   └── settings.py             # Chứa Hyperparameters (Step Size, Threshold sáng, InfoNCE Temp, Mức thưởng Jackpot...)
│
├── data/                       # Không gian chứa dữ liệu (Data-centric)
│   ├── annotation_vmr.jsonl    # File nhãn đa phương thức đã được làm sạch và chuẩn hóa
│   ├── roi.json                # Chứa tọa độ đa giác thiết lập mặt nạ Vùng quan tâm (ROI Masking)
│   ├── videos/                 # Chứa dữ liệu CCTV thô (.mp4)
│   └── offline_features/       # Chứa toàn bộ 3902 file Tensor (.pt) để nạp thẳng lên RAM (Pre-loading)
│
├── logs/                       # (Hoặc thư mục runs/) Chứa log để theo dõi Loss và mIoU trên nền tảng TensorBoard
│
├── models/                     # Kiến trúc mạng lõi (Hybrid Architecture)
│   ├── __init__.py
│   ├── backbones.py            # Chứa mô hình nền tảng CLIP (ViT-L/14) tích hợp module tinh chỉnh PEFT (mở khóa lớp 23)
│   ├── alignment.py            # Khối căn chỉnh chéo (Element-wise dot product) và Temporal Enhancement Loop
│   └── agent.py                # Mạng Actor-Critic (RL) với 5 không gian hành động (Dịch trái, phải, mở rộng, thu hẹp, dừng)
│
├── utils/                      # Công cụ hỗ trợ xử lý nền
│   ├── __init__.py
│   ├── preprocessing.py        # Hàm cân bằng sáng Conditional CLAHE và chạy YOLOv8 detection
│   └── metrics.py              # Công thức tính chỉ số đánh giá (mIoU, Recall@1) và Hàm phần thưởng (Reward)
│
├── app.py                      # Mã nguồn chạy giao diện ứng dụng Web UI (Text Query & Image Query)
├── check_data.py               # Công cụ tự động Audit/thống kê kiểm tra chất lượng file JSONL
├── data_loader.py              # Xử lý nạp dữ liệu (OfflineFeatureDataset) và gom nhóm Clip_id bằng defaultdict
├── merge_data.py               # Tool gộp nhãn và đồng bộ hóa ranh giới dữ liệu cho nhóm
├── split_dataset.py            # Kịch bản chia tập Train/Val/Test (chống Clip Leakage) và module split_complex_action
├── train.py                    # Luồng huấn luyện chính (Tích hợp vòng lặp Tiến trình quyết định Markov - MDP)
├── yolov8n.pt                  # Trọng số Pre-trained của YOLOv8 dùng làm lớp tiền xử lý
└── README.md                   # Hướng dẫn cài đặt môi trường và khởi chạy hệ thống
